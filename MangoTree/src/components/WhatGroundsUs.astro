---
import { Image } from "astro:assets";
import { API_URL } from "@utils/constants/url";
import type { Media } from "@lib/types/payload-types";

interface Props {
  mediaBlock?: Media;
}

const { mediaBlock } = Astro.props;
---

<section class="flex-container-wrapper bg-background">
  <div class="flex-container-main gap-16 w-full px-6 xl:w-5xl xl:px-0">
    <div class="flex flex-col text-center">
      <h2 class="font-bold text-3xl md:text-4xl text-mango-green mb-8">
        What Grounds and Grows Us
      </h2>
      <p class="text-muted text-lg max-w-3xl mx-auto leading-relaxed">
        We are citizens rooting out online manipulation with diverse skills in
        design, engineering, product management, policy, and more. Anyone can
        join in helping maintain a free and healthy online discourse.
      </p>
    </div>
    {
      mediaBlock != null && (
        <div class="flex justify-center items-center mt-16">
          <div class="w-full overflow-hidden shadow-lg">
            <Image
              src={`${API_URL}${mediaBlock.url}`}
              alt="Team meeting"
              class="w-full h-auto object-cover"
              width={mediaBlock.width as number}
              height={mediaBlock.height as number}
            />
          </div>
        </div>
      )
    }
  </div>
</section>
