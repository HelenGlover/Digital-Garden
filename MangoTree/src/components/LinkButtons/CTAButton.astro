---
import { baseButtonVariants } from "@lib/variants/button";
import { resolveClasses } from "@utils/classMerge";

interface Props {
  href: string;
  class?: string;
  target?: "_self" | "_blank" | "_top" | "_parent" | "_unfencedTop";
  rel?: string;
  variant?:
    | "primary"
    | "secondary"
    | "transparent"
    | "gold"
    | "transparent-secondary"
    | "transparent-gold";
}

const { href, target, rel, variant, class: className } = Astro.props;

const buttonClasses: string = resolveClasses(
  baseButtonVariants({ variant }),
  className,
  {
    "text-lg glass-shine-20 hover:-translate-y-0.5 active:-translate-y-px": true,
  },
);
---

<a href={href} target={target} rel={rel} class={buttonClasses}>
  <slot />
</a>
