---
import { cn } from "@utils/classMerge";

interface Props {
  href: string;
  class?: string;
  color?: string | null;
}

const { href, color, class: className } = Astro.props;
const cardClasses: string = cn(
  "flex flex-col transition-all transform-gpu duration-300 ease-default p-8 hover:-translate-1 hover:shadow-[0_0.50rem_1.50rem_rgba(90,138,74,0.15)] active:-translate-1 active:shadow-[0_0.50rem_1.50rem_rgba(90,138,74,0.15)]",
  className,
  color != null ? "bg-(--tools-card-background)" : null,
);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={cardClasses}
  style={color != null ? `--tools-card-background: ${color}` : null}
>
  <h3 class="font-bold text-2xl mb-4">
    <slot name="heading" />
  </h3>
  <p class="text-muted mb-4">
    <slot name="description" />
  </p>
  <span class="text-mango-green-dark font-semibold hover:underline"
    >Read more →</span
  >
</a>
